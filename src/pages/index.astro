---
import SlingshotCard from "../components/SlingshotCard.astro";
import products from "../data/products.json";
import "../styles/global.css";

interface Product {
  id: string;
  category: "forks" | "bands";
  name: string;
  material: string;
  description: string;
  price: number | string;
  image?: string;
  images?: string[];
}

const catalog = products as Product[];
const forks = catalog.filter((product) => product.category === "forks");
const bands = catalog.filter((product) => product.category === "bands");
const siteOrigin = Astro.site ?? new URL("https://zenith-fork.github.io");
const canonicalUrl = new URL("/", siteOrigin);
const socialImageUrl = new URL("/images/zenith-fork-social.png", canonicalUrl);
const pageTitle = "Zenith Fork | Handmade Wooden Slingshots & Latex Bands";
const pageDescription = "Explore one-of-one handmade wooden slingshots and precision-cut replacement latex flat bands from Zenith Fork Studio.";

const productListItems = catalog.map((product, index) => {
  const numericPrice = String(product.price).match(/\d+(?:\.\d+)?/)?.[0];
  const productUrl = new URL(`/products/${product.id}/`, siteOrigin).toString();
  const productImages = (product.images ?? (product.image ? [product.image] : [])).map((image) => new URL(image, siteOrigin).toString());

  return {
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "Product",
      "@id": productUrl,
      name: product.name,
      description: product.description,
      image: productImages,
      material: product.material,
      category: product.category === "forks" ? "Handmade wooden slingshots" : "Latex slingshot bands",
      brand: { "@type": "Brand", name: "Zenith Fork Studio" },
      url: productUrl,
      ...(numericPrice ? {
        offers: {
          "@type": "Offer",
          price: numericPrice,
          priceCurrency: "USD",
          availability: "https://schema.org/InStock",
          itemCondition: "https://schema.org/NewCondition",
          url: productUrl,
          seller: { "@id": new URL("/#organization", siteOrigin).toString() },
        },
      } : {}),
    },
  };
});

const homepageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": new URL("/#organization", siteOrigin).toString(),
      name: "Zenith Fork Studio",
      url: canonicalUrl.toString(),
      email: "hucdmail@gmail.com",
      image: socialImageUrl.toString(),
      description: "A small workshop focused on one-of-one solid-wood slingshots and replacement latex flat bands.",
    },
    {
      "@type": "WebSite",
      "@id": new URL("/#website", siteOrigin).toString(),
      url: canonicalUrl.toString(),
      name: "Zenith Fork Studio",
      publisher: { "@id": new URL("/#organization", siteOrigin).toString() },
    },
    {
      "@type": "ItemList",
      name: "Zenith Fork Studio product collection",
      numberOfItems: productListItems.length,
      itemListElement: productListItems,
    },
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-zinc-950">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="google-site-verification" content="Hjfq1NrQB-3VyZxsPCzZFsIdMtlsxWmS4fQnUekuxB8" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Zenith Fork Studio" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Handcrafted ebony wooden slingshot by Zenith Fork Studio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Handcrafted ebony wooden slingshot by Zenith Fork Studio" />
    <script type="application/ld+json" set:html={JSON.stringify(homepageSchema)} />
  </head>

  <body class="min-h-screen bg-zinc-950 text-zinc-300 antialiased selection:bg-amber-400 selection:text-zinc-950">
    <header class="sticky top-0 z-40 border-b border-zinc-800/80 bg-zinc-950/90 backdrop-blur-xl">
      <nav class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-6 py-4 lg:flex-row lg:py-5" aria-label="Primary navigation">
        <a class="text-base font-black tracking-[0.22em] text-white" href="#top" aria-label="Zenith Fork home">ZENITH.FORK</a>
        <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm font-medium sm:gap-x-8">
          <a class="transition hover:text-amber-400" href="#forks">Slingshots</a>
          <a class="transition hover:text-amber-400" href="#consumables">Consumables</a>
          <a class="transition hover:text-amber-400" href="#learn">Learn</a>
          <a class="transition hover:text-amber-400" href="/blog/">Journal</a>
          <a class="transition hover:text-amber-400" href="/about/">Workshop</a>
          <a class="transition hover:text-amber-400" href="#contact">Contact</a>
        </div>
      </nav>
    </header>

    <main id="top">
      <section class="mx-auto grid min-h-[70vh] max-w-7xl place-items-center px-6 py-24 text-center">
        <div class="max-w-4xl">
          <p class="text-sm font-bold uppercase tracking-[0.32em] text-amber-400">Exotic timber · shaped by hand</p>
          <h1 class="mt-7 text-5xl font-black tracking-tight text-white sm:text-7xl">
            Handmade wooden slingshots.<br />Built one at a time.
          </h1>
          <p class="mx-auto mt-7 max-w-2xl text-lg leading-8 text-zinc-400">
            Premium asymmetric wooden slingshots and matched latex flat bands—made and selected in small batches.
          </p>
          <a class="mt-10 inline-flex rounded-full bg-amber-400 px-7 py-4 font-bold text-zinc-950 transition hover:bg-amber-300" href="#forks">
            Explore the collection
          </a>
        </div>
      </section>

      <section id="forks" class="mx-auto max-w-7xl scroll-mt-28 px-6 py-20">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-amber-400">One-of-one hardwood slingshots</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">Custom Wooden Slingshots</h2>
        <div class="mt-10 grid gap-7 md:grid-cols-2 lg:grid-cols-3">
          {forks.map((product) => <SlingshotCard {...product} />)}
        </div>
      </section>

      <div id="consumables" class="scroll-mt-28">
        <section class="mx-auto max-w-7xl px-6 py-20">
          <p class="text-sm font-semibold uppercase tracking-[0.24em] text-amber-400">Replacement bands for wooden slingshots</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">Flat Bands & Band-Tying Tape</h2>
          <div class="mt-10 grid gap-7 md:grid-cols-2 lg:grid-cols-3">
            {bands.map((product) => <SlingshotCard {...product} />)}
          </div>
        </section>

      </div>

      <article id="learn" class="mx-auto max-w-3xl scroll-mt-28 px-6 py-24 leading-8 text-zinc-300">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-amber-400">Workshop notes / 2026</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">
          Choosing Flat Bands for a Handmade Wooden Slingshot
        </h2>

        <p class="mt-8">
          A handheld slingshot is a simple elastic system, but the way its parts work together matters. The wooden frame anchors the bands, the latex stores energy during the draw, and the pouch must return cleanly when released. Small inconsistencies become more noticeable over distance. That is why a custom wooden slingshot should be evaluated as a complete setup, not merely as a carved object. Dense hardwood provides a stable frame, while a carefully shaped grip helps the user repeat the same hand position. In a handmade wooden slingshot, comfort is part of consistency: a natural hold reduces unnecessary movement during each shot.
        </p>

        <h3 class="mt-10 text-2xl font-semibold text-white">Start with the frame and your draw length</h3>
        <p class="mt-4">
          Band choice begins with the fork tips, attachment method, and the user's measured draw length. A band that is too short can feel harsh and may wear quickly; one that is too long can feel slow and make a clean release harder to repeat. The useful starting point is a moderate setup that suits the frame and the person using it. From there, active band length and taper can be adjusted in small steps. Record each change instead of replacing several variables at once, and stop using any band that shows cuts, whitening, or damaged edges.
        </p>

        <h3 class="mt-10 text-2xl font-semibold text-white">Why a tapered flat band improves efficiency</h3>
        <p class="mt-4">
          A tapered latex band is wider where it attaches to the wooden slingshot frame and narrower near the pouch. This geometry reduces moving mass at the fast end of the system, allowing the latex to retract cleanly while maintaining useful strength at the attachment point. Thickness, taper ratio, active length, temperature, and pull length must still work together. Excessive taper can shorten service life; too little can feel slow and inefficient. Regular inspection for nicks, whitening, or edge damage remains essential before every session.
        </p>

        <h3 class="mt-10 text-2xl font-semibold text-white">The best wooden slingshot is a balanced setup</h3>
        <p class="mt-4">
          The best wooden slingshot is not automatically the model with the strongest bands. It is the hardwood frame, band, and pouch combination that the user can handle consistently. Zenith Fork Studio pairs comfortable solid-wood frames with clearly specified replacement bandsets so each component has a clear role. Use eye protection, maintain a secure backstop, inspect the bands before use, and follow all local laws. Consistent target practice begins with careful setup before each shot.
        </p>
      </article>
    </main>

    <footer id="contact" class="scroll-mt-28 border-t border-zinc-800 bg-black px-6 py-12 text-center text-sm leading-7 text-zinc-500">
      <div class="mx-auto mb-10 max-w-2xl">
        <h2 class="text-2xl font-bold tracking-tight text-white">Contact Zenith Fork Studio</h2>
        <p class="mt-3 text-zinc-400">Email us about product availability, shipping, or an existing order.</p>
        <address class="mt-5 not-italic">
          <a
            class="text-base font-semibold text-amber-400 transition hover:text-amber-300"
            href="mailto:hucdmail@gmail.com"
            aria-label="Email Zenith Fork Studio at hucdmail@gmail.com"
          >
            hucdmail@gmail.com
          </a>
        </address>
      </div>
      <p class="mx-auto max-w-4xl">
        After availability, destination, payment, and shipping are confirmed by email, wooden slingshots are discreetly packed in unmarked parcels using DDP tax-inclusive routes. We cannot accept or fulfill requests for Singapore or Australia (NSW/VIC). Do not request shipment where slingshots or related items are prohibited by local law.
      </p>
      <p class="mt-5">© {new Date().getFullYear()} Zenith Fork Studio. Use responsibly and comply with local law.</p>
      <p class="mt-3"><a class="transition hover:text-amber-400" href="/about/">About the workshop</a> · <a class="transition hover:text-amber-400" href="/blog/">Workshop journal</a></p>
    </footer>
  </body>
</html>
