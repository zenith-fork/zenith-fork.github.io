---
export interface Props {
  id: string;
  category: "forks" | "ammo" | "bands";
  name: string;
  material: string;
  description: string;
  price: number;
  image: string;
  checkoutUrl: string;
}

const { id, category, name, material, description, price, image, checkoutUrl } = Astro.props;
const categoryLabel = {
  forks: "wooden slingshot",
  bands: "latex bands",
  ammo: "slingshot ammo",
}[category];
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/80 shadow-2xl shadow-black/20 transition duration-300 hover:-translate-y-1 hover:border-amber-500/50"
  aria-labelledby={`${id}-title`}
>
  <div class="aspect-[4/3] overflow-hidden bg-zinc-950">
    <img
      class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
      src={image}
      alt={`${name} — ${material}`}
      width="720"
      height="540"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="flex flex-1 flex-col p-6">
    <p class="mb-3 text-xs font-semibold uppercase tracking-[0.24em] text-amber-400">{categoryLabel}</p>
    <h3 id={`${id}-title`} class="text-xl font-semibold tracking-tight text-white">{name}</h3>
    <p class="mt-2 text-sm text-zinc-400">{material}</p>
    <p class="mt-4 flex-1 leading-7 text-zinc-300">{description}</p>

    <div class="mt-6 flex items-center justify-between gap-4 border-t border-zinc-800 pt-5">
      <p class="text-lg font-semibold text-white">
        <span class="sr-only">Price:</span>${price.toFixed(2)} <span class="text-xs text-zinc-500">USD</span>
      </p>
      <button
        type="button"
        class="buy-now rounded-full bg-amber-400 px-5 py-3 text-sm font-bold tracking-wide text-zinc-950 transition hover:bg-amber-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-900"
        data-dialog-id={`${id}-restriction-dialog`}
        aria-label={`Buy ${name} now`}
      >
        BUY NOW →
      </button>
    </div>
  </div>
</article>

<dialog
  id={`${id}-restriction-dialog`}
  class="restriction-dialog m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-zinc-800 bg-zinc-950 p-0 text-zinc-300 shadow-2xl shadow-black/70 backdrop:bg-black/80 backdrop:backdrop-blur-sm"
  aria-labelledby={`${id}-restriction-title`}
  aria-describedby={`${id}-restriction-description`}
>
  <div class="relative p-6 sm:p-7">
    <form method="dialog" class="absolute right-4 top-4">
      <button
        class="flex h-9 w-9 items-center justify-center rounded-lg text-xl text-zinc-500 transition hover:bg-zinc-900 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-500"
        value="cancel"
        aria-label="Close shipping restriction notice"
      >
        ×
      </button>
    </form>

    <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-amber-400/30 bg-amber-400/10 text-xl text-amber-400" aria-hidden="true">!</div>

    <p class="mt-6 text-xs font-bold uppercase tracking-[0.24em] text-amber-400">Shipping restriction</p>
    <h2 id={`${id}-restriction-title`} class="mt-3 text-xl font-semibold leading-tight text-white">Confirm your delivery region</h2>

    <div id={`${id}-restriction-description`} class="mt-5 space-y-4 leading-7 text-zinc-300">
      <p>
        <strong class="text-white">Restricted zones:</strong> Singapore and Australia (NSW/VIC) — orders are canceled automatically and refunded.
      </p>
      <p>
        If slingshots or related items are illegal in your country or region, please do not purchase.
      </p>
      <p class="text-sm text-zinc-500">By continuing, you confirm that your delivery address is outside these restricted zones and that your purchase complies with local law.</p>
    </div>

    <div class="mt-7 flex flex-col-reverse gap-2 border-t border-zinc-800 pt-5 sm:flex-row sm:items-center sm:justify-end">
      <form method="dialog">
        <button class="w-full rounded-lg px-5 py-2.5 text-sm font-semibold text-zinc-400 transition hover:bg-zinc-900 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-500 sm:w-auto" value="cancel">
          Cancel
        </button>
      </form>
      <button
        type="button"
        class="continue-checkout w-full whitespace-nowrap rounded-lg bg-amber-400 px-6 py-2.5 text-sm font-bold text-zinc-950 shadow-lg shadow-amber-400/10 transition hover:bg-amber-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950 sm:w-auto"
        data-checkout-url={checkoutUrl}
      >
        Continue to checkout →
      </button>
    </div>
  </div>
</dialog>

<script>
  document.querySelectorAll<HTMLButtonElement>(".buy-now").forEach((button) => {
    button.addEventListener("click", () => {
      const dialogId = button.dataset.dialogId;
      const dialog = dialogId ? document.getElementById(dialogId) : null;

      if (dialog instanceof HTMLDialogElement && !dialog.open) {
        dialog.showModal();
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".continue-checkout").forEach((button) => {
    button.addEventListener("click", () => {
      const checkoutUrl = button.dataset.checkoutUrl;

      if (checkoutUrl) {
        window.location.assign(checkoutUrl);
      }
    });
  });
</script>
