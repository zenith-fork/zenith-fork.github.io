---
export interface Props {
  id: string;
  category: "forks" | "bands";
  name: string;
  material: string;
  description: string;
  price: number | string;
  image?: string;
  images?: string[];
}

const { id, category, name, material, description, price, image, images } = Astro.props;
const productImages = [...(images ?? []), ...(image && !images?.includes(image) ? [image] : [])].filter(Boolean);
if (productImages.length === 0) {
  throw new Error(`Product ${id} must provide an image or a non-empty images array.`);
}
const hasMultipleImages = productImages.length > 1;
const transparentPlaceholder = "data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=";
const categoryLabel = {
  forks: "wooden slingshot",
  bands: "latex bands",
}[category];
const formattedPrice = typeof price === "number" ? `$${price.toFixed(2)} USD` : price;
const emailSubject = `Product inquiry: ${name}`;
const emailBody = `Hello Zenith Fork Studio,

I am interested in the following product:

Product: ${name}
Listed price: ${formattedPrice}

Delivery country/region:
Quantity:
Questions:

Please confirm availability, shipping options, final payment details, and whether delivery is permitted to my location.

Thank you.`;
const mailtoUrl = `mailto:hucdmail@gmail.com?subject=${encodeURIComponent(emailSubject)}&body=${encodeURIComponent(emailBody)}`;
---

<article
  id={id}
  class="group flex h-full scroll-mt-28 flex-col overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/80 shadow-2xl shadow-black/20 transition duration-300 hover:-translate-y-1 hover:border-amber-500/50"
  aria-labelledby={`${id}-title`}
>
  <div
    class="product-carousel relative aspect-square touch-pan-y overflow-hidden bg-zinc-950"
    data-carousel
    data-product-name={name}
    tabindex={hasMultipleImages ? "0" : undefined}
    aria-label={hasMultipleImages ? `${name} image gallery` : undefined}
  >
    <div class="relative h-full w-full">
      {productImages.map((productImage, index) => (
        <img
          class:list={[
            "carousel-slide absolute inset-0 h-full w-full object-cover transition duration-500 motion-reduce:transition-none",
            index === 0 ? "opacity-100" : "pointer-events-none opacity-0",
          ]}
          src={index === 0 ? productImage : transparentPlaceholder}
          data-src={index === 0 ? undefined : productImage}
          alt={`${name} — ${material}${hasMultipleImages ? ` — view ${index + 1} of ${productImages.length}` : ""}`}
          width="720"
          height="720"
          loading="lazy"
          decoding="async"
          data-slide-index={index}
          aria-hidden={index === 0 ? "false" : "true"}
        />
      ))}
    </div>

    {hasMultipleImages && (
      <>
        <button
          type="button"
          class="carousel-previous absolute left-3 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-black/65 text-2xl text-white shadow-lg backdrop-blur transition hover:border-amber-400/60 hover:bg-black/85 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
          aria-label={`Show previous image of ${name}`}
        >
          <span aria-hidden="true">‹</span>
        </button>
        <button
          type="button"
          class="carousel-next absolute right-3 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-black/65 text-2xl text-white shadow-lg backdrop-blur transition hover:border-amber-400/60 hover:bg-black/85 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
          aria-label={`Show next image of ${name}`}
        >
          <span aria-hidden="true">›</span>
        </button>

        <div class="absolute inset-x-0 bottom-3 z-10 flex justify-center gap-2" aria-label="Choose product image">
          {productImages.map((_, index) => (
            <button
              type="button"
              class:list={[
                "carousel-dot h-2.5 rounded-full shadow transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2 focus-visible:ring-offset-black",
                index === 0 ? "w-7 bg-amber-400" : "w-2.5 bg-white/65 hover:bg-white",
              ]}
              data-dot-index={index}
              aria-label={`Show image ${index + 1} of ${productImages.length}`}
              aria-current={index === 0 ? "true" : "false"}
            />
          ))}
        </div>
        <p class="sr-only" aria-live="polite" data-carousel-status>Image 1 of {productImages.length}</p>
      </>
    )}
  </div>

  <div class="flex flex-1 flex-col p-6">
    <p class="mb-3 text-xs font-semibold uppercase tracking-[0.24em] text-amber-400">{categoryLabel}</p>
    <h3 id={`${id}-title`} class="text-xl font-semibold tracking-tight text-white"><a href={`/products/${id}/`} class="hover:text-amber-400">{name}</a></h3>
    <p class="mt-2 text-sm text-zinc-400">{material}</p>
    <p class="mt-4 flex-1 leading-7 text-zinc-300">{description}</p>

    <div class="mt-6 flex items-center justify-between gap-4 border-t border-zinc-800 pt-5">
      <p class="text-lg font-semibold text-white">
        <span class="sr-only">Price:</span>{formattedPrice}
      </p>
      <a
        class="rounded-full bg-amber-400 px-5 py-3 text-center text-sm font-bold tracking-wide text-zinc-950 transition hover:bg-amber-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-900"
        href={mailtoUrl}
        aria-label={`Email Zenith Fork Studio about ${name}`}
      >
        EMAIL TO ORDER →
      </a>
    </div>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    if (carousel.dataset.initialized === "true") return;

    const slides = Array.from(carousel.querySelectorAll<HTMLElement>(".carousel-slide"));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>(".carousel-dot"));
    if (slides.length < 2) return;

    carousel.dataset.initialized = "true";
    const status = carousel.querySelector<HTMLElement>("[data-carousel-status]");
    let currentIndex = 0;
    let touchStartX = 0;

    const loadSlide = (index: number) => {
      const slide = slides[index];
      const deferredSource = slide?.dataset.src;
      if (slide instanceof HTMLImageElement && deferredSource) {
        slide.src = deferredSource;
        delete slide.dataset.src;
      }
    };

    const showSlide = (nextIndex: number) => {
      currentIndex = (nextIndex + slides.length) % slides.length;
      loadSlide(currentIndex);

      slides.forEach((slide, index) => {
        const isActive = index === currentIndex;
        slide.classList.toggle("opacity-100", isActive);
        slide.classList.toggle("opacity-0", !isActive);
        slide.classList.toggle("pointer-events-none", !isActive);
        slide.setAttribute("aria-hidden", String(!isActive));
      });

      dots.forEach((dot, index) => {
        const isActive = index === currentIndex;
        dot.classList.toggle("w-7", isActive);
        dot.classList.toggle("w-2.5", !isActive);
        dot.classList.toggle("bg-amber-400", isActive);
        dot.classList.toggle("bg-white/65", !isActive);
        dot.setAttribute("aria-current", String(isActive));
      });

      if (status) status.textContent = `Image ${currentIndex + 1} of ${slides.length}`;
    };

    carousel.querySelector<HTMLButtonElement>(".carousel-previous")?.addEventListener("click", () => showSlide(currentIndex - 1));
    carousel.querySelector<HTMLButtonElement>(".carousel-next")?.addEventListener("click", () => showSlide(currentIndex + 1));
    dots.forEach((dot) => dot.addEventListener("click", () => showSlide(Number(dot.dataset.dotIndex))));

    carousel.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") showSlide(currentIndex - 1);
      if (event.key === "ArrowRight") showSlide(currentIndex + 1);
    });
    carousel.addEventListener("touchstart", (event) => {
      touchStartX = event.changedTouches[0]?.clientX ?? 0;
    }, { passive: true });
    carousel.addEventListener("touchend", (event) => {
      const distance = (event.changedTouches[0]?.clientX ?? touchStartX) - touchStartX;
      if (Math.abs(distance) < 45) return;
      showSlide(currentIndex + (distance < 0 ? 1 : -1));
    }, { passive: true });
  });

</script>
